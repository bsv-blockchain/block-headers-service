# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for block-headers-service
# Load Order: 90 (loaded late, overrides defaults from earlier files)
#
# This file contains configuration specific to this project that overrides
# defaults from the base configuration files (00-core.env, 10-*.env, 20-*.env).
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.25.x

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.25.x

# MAGE-X Go version overrides
MAGE_X_GO_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x

# ================================================================================================
# 📊 COVERAGE PROVIDER
# ================================================================================================

# Use Codecov as the coverage provider (overrides internal default from 10-coverage.env)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# ================================================================================================
# 🚫 COVERAGE EXCLUSIONS (matches codecov.yml ignore paths)
# ================================================================================================

GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,test/,testing/,vendor/,testdata/

# ================================================================================================
# 🔒 SECURITY EXCLUSIONS
# ================================================================================================

# CVE-2026-26958: filippo.io/edwards25519 - upgraded to v1.2.0 which includes the fix
# Kept as exclusion in case Nancy flags the old version hash still present in go.sum
#
# github.com/apache/thrift@v0.16.0 (transitive): CVE-2025-48431, CVE-2026-41602, CVE-2026-41603,
#   CVE-2026-41605, CVE-2026-43869, CVE-2026-41607, CVE-2026-41606, CVE-2026-43868
#   CVE-2026-48144, CVE-2026-58023 (c_glib bindings), CVE-2026-55968 (Node.js bindings),
#   CVE-2026-58662 (C++ bindings), CVE-2026-55969 (C++/c_glib/Go/netstd/Delphi/Haxe bindings),
#   CVE-2026-48586 (C++/Java/Python/Go/D/C_glib bindings) -
#   these affect non-Go language bindings shipped in the same repo, not the Go client we use
# github.com/jackc/pgx/v4@v4.18.2 and pgx/v5@v5.5.4 (transitive): CVE-2026-41889 (SQL Injection)
#
# github.com/docker/docker@v28.5.2+incompatible (transitive, test-only: golang-migrate's own
#   postgres driver tests pull in dhui/dktest, and regressiontests/ pulls in testcontainers-go —
#   the latter is gated behind the "regression" build tag, already excluded from CI builds/tests
#   below): CVE-2026-33997 (GO-2026-4883 / GHSA-pxq6-2prw-chj9, plugin-install privilege
#   validation off-by-one) and CVE-2026-34040 (GO-2026-4887 / GHSA-x744-4wpc-v9h2, AuthZ plugin
#   bypass via oversized request bodies) - both are bugs in the Docker *daemon* (dockerd); this
#   project only imports docker/docker's client-side API types to talk to an external daemon in
#   tests, it never runs dockerd, so the vulnerable code paths are unreachable. No fix is
#   available on this module path: upstream (moby/moby) fixed it in docker-v29.3.1 but moved to
#   a "docker-vNN.N.N" tag scheme Go modules can't resolve for this import path, with the real
#   fix living in the still-beta github.com/moby/moby/v2 - neither dktest (v0.4.6, latest) nor
#   testcontainers-go (v0.44.0, latest) have adopted it
NANCY_EXCLUDES=CVE-2026-26958,CVE-2026-4427,CVE-2026-34986,CVE-2026-32286,CVE-2026-33815,CVE-2026-33816,CVE-2026-5160,CVE-2026-39882,CVE-2025-48431,CVE-2026-41602,CVE-2026-41603,CVE-2026-41605,CVE-2026-43869,CVE-2026-41607,CVE-2026-41606,CVE-2026-43868,CVE-2026-41889,CVE-2026-2303,CVE-2026-48144,CVE-2026-58023,CVE-2026-55968,CVE-2026-58662,CVE-2026-55969,CVE-2026-48586,CVE-2026-33997,CVE-2026-34040
MAGE_X_CVE_EXCLUDES=CVE-2026-26958,CVE-2026-4427,CVE-2026-33815,CVE-2026-33816,CVE-2026-5160,CVE-2026-39882,CVE-2025-48431,CVE-2026-41602,CVE-2026-41603,CVE-2026-41605,CVE-2026-43869,CVE-2026-41607,CVE-2026-41606,CVE-2026-43868,CVE-2026-41889,CVE-2026-2303,GO-2026-5932,CVE-2026-48144,CVE-2026-58023,CVE-2026-55968,CVE-2026-58662,CVE-2026-55969,CVE-2026-48586,CVE-2026-33997,CVE-2026-34040

# ================================================================================================
# 🔧 MAGE-X BUILD CONFIGURATION
# ================================================================================================

# Exclude regression tests from build tag auto-discovery (they require Docker, external APIs, and long sync times)
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,regression
MAGE_X_BUILD_EXCLUDE_PATTERN=regression
MAGE_X_TEST_EXCLUDE_MODULES=regression
